# API keys for the researcher agent. Copy to .env (gitignored) for local dev.
# In GitHub Actions, set these as repository secrets.

# Required for classifier (free tier from Google AI Studio).
GEMINI_API_KEY=

# Optional. Only used by the weekly agent for higher-quality synthesis.
# Falls back to Gemini if unset. Weekly cost expected < $0.20.
ANTHROPIC_API_KEY=

# Optional for local dev. In GitHub Actions, the default GITHUB_TOKEN
# is provisioned automatically and gives 1000 req/hour.
GITHUB_TOKEN=
